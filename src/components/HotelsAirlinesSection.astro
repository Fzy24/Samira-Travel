---
/**
 * Komponen HotelsAirlinesSection (Bagian I pada Struktur Website).
 * Menampilkan 9 hotel referensi yang dikaitkan dengan masing-masing tingkatan paket
 * (Safara, Safawi, Sukari, Majol) dan kota (Makkah & Madinah), lengkap dengan filter interaktif
 * serta daftar 3 maskapai penerbangan pada materi klien.
 */
import { getHotelReferences } from '../data/hotels';
import { AIRLINE_REFERENCES } from '../data/packages';
import { getOfficialWhatsAppUrl } from '../utils/whatsapp';
import VerificationBadge from './VerificationBadge.astro';

const hotels = getHotelReferences();
---

<section
  id="hotel-fasilitas"
  class="section-padding bg-white text-charcoal border-b border-navy-100/70"
  aria-labelledby="hotel-heading"
>
  <div class="container-luxury">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="max-w-3xl space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="badge-eyebrow">Referensi Hotel &amp; Maskapai</span>
          <VerificationBadge status="NEEDS_CONFIRMATION" />
        </div>
        <h2
          id="hotel-heading"
          class="font-editorial text-3xl font-bold text-navy-800 sm:text-4xl lg:text-5xl"
        >
          Direktori Hotel Referensi Makkah &amp; Madinah per Tingkatan Paket
        </h2>
        <p class="text-base sm:text-lg text-charcoal-muted leading-relaxed">
          Sembilan hotel di bawah ini merupakan referensi akomodasi dalam materi Product Knowledge Samira Travel. Ketersediaan hotel, tipe kamar, dan jarak aktual ke pelataran masjid dikonfirmasi sesuai jadwal keberangkatan yang dipilih.
        </p>
      </div>

      <!-- Tombol Filter Kota & Paket -->
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter daftar hotel referensi">
        <button
          type="button"
          data-hotel-filter="ALL"
          aria-pressed="true"
          class="rounded-xl border border-navy-700 bg-navy-700 px-3.5 py-2 text-xs font-semibold text-white transition-colors"
        >
          Semua (9)
        </button>
        <button
          type="button"
          data-hotel-filter="CITY:Makkah"
          aria-pressed="false"
          class="rounded-xl border border-navy-200 bg-ivory-50 px-3.5 py-2 text-xs font-semibold text-navy-800 transition-colors hover:bg-navy-50"
        >
          Makkah (5)
        </button>
        <button
          type="button"
          data-hotel-filter="CITY:Madinah"
          aria-pressed="false"
          class="rounded-xl border border-navy-200 bg-ivory-50 px-3.5 py-2 text-xs font-semibold text-navy-800 transition-colors hover:bg-navy-50"
        >
          Madinah (4)
        </button>
        <button
          type="button"
          data-hotel-filter="TIER:SAFARA"
          aria-pressed="false"
          class="rounded-xl border border-navy-200 bg-ivory-50 px-3.5 py-2 text-xs font-semibold text-navy-800 transition-colors hover:bg-navy-50"
        >
          Paket Safara
        </button>
        <button
          type="button"
          data-hotel-filter="TIER:SAFAWI"
          aria-pressed="false"
          class="rounded-xl border border-navy-200 bg-ivory-50 px-3.5 py-2 text-xs font-semibold text-navy-800 transition-colors hover:bg-navy-50"
        >
          Paket Safawi
        </button>
        <button
          type="button"
          data-hotel-filter="TIER:SUKARI"
          aria-pressed="false"
          class="rounded-xl border border-navy-200 bg-ivory-50 px-3.5 py-2 text-xs font-semibold text-navy-800 transition-colors hover:bg-navy-50"
        >
          Paket Sukari
        </button>
        <button
          type="button"
          data-hotel-filter="TIER:MAJOL"
          aria-pressed="false"
          class="rounded-xl border border-navy-200 bg-ivory-50 px-3.5 py-2 text-xs font-semibold text-navy-800 transition-colors hover:bg-navy-50"
        >
          Paket Majol
        </button>
      </div>
    </div>

    <!-- Grid 9 Kartu Hotel Referensi -->
    <div id="hotel-reference-grid" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        hotels.map((hotel) => (
          <article
            data-hotel-card
            data-hotel-city={hotel.city}
            data-hotel-tier={hotel.tierCode}
            class="card-surface card-surface-hover flex flex-col justify-between overflow-hidden"
          >
            <div>
              <div class="relative h-52 overflow-hidden bg-navy-800">
                <img
                  src={hotel.imageUrl}
                  alt={hotel.imageAlt}
                  width="460"
                  height="276"
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                />
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  <span class="rounded-lg bg-navy-900/90 px-2.5 py-1 text-xs font-bold text-gold-300 backdrop-blur-sm">
                    {hotel.city}
                  </span>
                  <span class="rounded-lg bg-royal-700/90 px-2.5 py-1 text-xs font-semibold text-white backdrop-blur-sm">
                    {hotel.tierName}
                  </span>
                </div>
              </div>

              <div class="p-5 space-y-3">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h3 class="font-editorial text-2xl font-bold text-navy-800">
                      {hotel.name}
                    </h3>
                    <p class="text-xs font-medium text-gold-700">
                      Referensi Brosur: Bintang {hotel.starRatingInBrochure} ({'★'.repeat(hotel.starRatingInBrochure)})
                    </p>
                  </div>
                  <VerificationBadge status={hotel.status} />
                </div>

                <div class="rounded-xl bg-ivory-100 p-3 text-xs space-y-1">
                  <strong class="text-navy-800 block">Jarak Tercantum pada Materi:</strong>
                  <p class="text-charcoal-muted">{hotel.distanceInDoc}</p>
                </div>

                <ul class="space-y-1 text-xs text-charcoal-muted">
                  {hotel.featuresShownInDoc.map((feat) => (
                    <li class="flex items-center gap-2">
                      <span class="h-1.5 w-1.5 rounded-full bg-turquoise-500" aria-hidden="true" />
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="p-5 pt-0 flex items-center justify-between border-t border-navy-50 mt-2 pt-3">
              <span class="text-[11px] text-charcoal-muted">{hotel.sourceSlide}</span>
              <a
                href={getOfficialWhatsAppUrl({
                  packageName: `${hotel.tierName} (Referensi Hotel ${hotel.name} - ${hotel.city})`,
                })}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-royal-700 hover:text-navy-900 underline-offset-4 hover:underline"
              >
                Tanyakan Ketersediaan &rarr;
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Referensi Maskapai Penerbangan (Slide 24) -->
    <div class="mt-14 rounded-2xl border border-navy-100 bg-ivory-100 p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-royal-700">
            Referensi Transportasi Udara (Slide 24)
          </span>
          <h3 class="mt-1 font-editorial text-2xl sm:text-3xl font-bold text-navy-800">
            Maskapai Penerbangan dalam Materi Produk
          </h3>
        </div>
        <VerificationBadge status="NEEDS_CONFIRMATION" />
      </div>
      <p class="mt-2 text-xs sm:text-sm text-charcoal-muted max-w-3xl">
        Penggunaan maskapai penerbangan bergantung pada rute kota keberangkatan (embarkasi) dan jadwal yang telah dikonfirmasi untuk masing-masing program.
      </p>

      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          AIRLINE_REFERENCES.map((airline) => (
            <div class="rounded-xl border border-navy-100 bg-white p-5 shadow-sm">
              <div class="flex items-center justify-between gap-2">
                <h4 class="font-editorial text-xl font-bold text-navy-800">
                  {airline.name}
                </h4>
                <span class="text-xs font-semibold text-royal-600">Maskapai Referensi</span>
              </div>
              <p class="mt-2 text-xs leading-relaxed text-charcoal-muted">
                {airline.routeNoteInDoc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Mengatur filter interaktif pada direktori hotel referensi berdasarkan kota (Makkah/Madinah)
   * atau kode tingkatan paket (SAFARA, SAFAWI, SUKARI, MAJOL).
   */
  function setupHotelDirectoryFilter(): void {
    const filterButtons = document.querySelectorAll('[data-hotel-filter]');
    const hotelCards = document.querySelectorAll('[data-hotel-card]');

    if (!filterButtons.length || !hotelCards.length) {
      return;
    }

    /**
     * Menerapkan nilai filter yang dipilih dan memperbarui tampilan kartu hotel serta state aria-pressed.
     *
     * @param filterRule Aturan filter ('ALL', 'CITY:Makkah', 'TIER:SUKARI', dll.).
     */
    function applyHotelFilter(filterRule: string): void {
      filterButtons.forEach((btn) => {
        const isSelected = btn.getAttribute('data-hotel-filter') === filterRule;
        btn.setAttribute('aria-pressed', String(isSelected));
        btn.classList.toggle('bg-navy-700', isSelected);
        btn.classList.toggle('text-white', isSelected);
        btn.classList.toggle('border-navy-700', isSelected);
        btn.classList.toggle('bg-ivory-50', !isSelected);
        btn.classList.toggle('text-navy-800', !isSelected);
        btn.classList.toggle('border-navy-200', !isSelected);
      });

      hotelCards.forEach((card) => {
        const el = card as HTMLElement;
        const cardCity = el.getAttribute('data-hotel-city') || '';
        const cardTier = el.getAttribute('data-hotel-tier') || '';

        let visible = true;
        if (filterRule.startsWith('CITY:')) {
          visible = cardCity === filterRule.replace('CITY:', '');
        } else if (filterRule.startsWith('TIER:')) {
          visible = cardTier === filterRule.replace('TIER:', '');
        }

        el.classList.toggle('hidden', !visible);
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const rule = btn.getAttribute('data-hotel-filter') || 'ALL';
        applyHotelFilter(rule);
      });
    });
  }

  setupHotelDirectoryFilter();
</script>
