---
/**
 * Komponen FireflyCursor.
 * Menghadirkan efek visual cahaya lembut (glow) dan partikel kunang-kunang organik
 * yang mengikuti gerakan pointer mouse dengan interpolasi halus.
 *
 * Mematuhi seluruh persyaratan performa & aksesibilitas:
 * - Berada pada layer dekoratif (pointer-events: none) sehingga tidak menghalangi klik.
 * - Membatasi jumlah partikel maksimal 14 titik agar ringan.
 * - Otomatis dinonaktifkan pada perangkat sentuh (touch) dan saat prefers-reduced-motion aktif.
 * - Membersihkan event listener serta requestAnimationFrame saat komponen dilepas.
 */
---

<div
  id="firefly-cursor-layer"
  class="pointer-events-none fixed inset-0 z-40 hidden overflow-hidden select-none"
  aria-hidden="true"
>
  <canvas id="firefly-cursor-canvas" class="h-full w-full pointer-events-none"></canvas>
</div>

<script>
  interface FireflyParticle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    alpha: number;
    targetAlpha: number;
    phase: number;
    phaseSpeed: number;
    hueType: 'gold' | 'turquoise';
  }

  /**
   * Memeriksa apakah perangkat mendukung pointer presisi (mouse/trackpad)
   * dan pengguna tidak mengaktifkan preferensi pengurangan gerakan (reduced motion).
   *
   * @returns Nilai boolean apakah efek kunang-kunang diizinkan berjalan.
   */
  function shouldEnableFireflyEffect(): boolean {
    if (typeof window === 'undefined' || !('requestAnimationFrame' in window)) {
      return false;
    }
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hasFinePointer = window.matchMedia('(pointer: fine)').matches;
    return !prefersReducedMotion && hasFinePointer;
  }

  /**
   * Melakukan interpolasi linier (lerp) antara dua nilai untuk menghasilkan
   * pergerakan cahaya kursor yang halus dan organik.
   *
   * @param start Posisi awal saat ini.
   * @param end Posisi target pointer.
   * @param amount Faktor kehalusan interpolasi (0 hingga 1).
   * @returns Nilai posisi hasil interpolasi.
   */
  function interpolatePosition(start: number, end: number, amount: number): number {
    return start + (end - start) * amount;
  }

  /**
   * Menginisialisasi sistem animasi cahaya pointer dan partikel kunang-kunang pada elemen canvas,
   * lengkap dengan pembersihan resource otomatis untuk mencegah kebocoran memori.
   *
   * @returns Fungsi pembersih (cleanup) untuk menghentikan frame animasi dan melepas event listener.
   */
  function initFireflyCursorSystem(): () => void {
    const container = document.getElementById('firefly-cursor-layer');
    const canvas = document.getElementById('firefly-cursor-canvas') as HTMLCanvasElement | null;

    if (!container || !canvas || !shouldEnableFireflyEffect()) {
      return () => {};
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) {
      return () => {};
    }

    container.classList.remove('hidden');

    const MAX_PARTICLES = 14;
    const particles: FireflyParticle[] = [];

    let width = window.innerWidth;
    let height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;

    const pointer = {
      targetX: width * 0.5,
      targetY: height * 0.35,
      currentX: width * 0.5,
      currentY: height * 0.35,
      isActive: false,
      lastMoveTime: 0,
    };

    /**
     * Membuat satu partikel kunang-kunang baru di sekitar posisi pointer dengan variasi kecil
     * pada ukuran, kecepatan apung, dan warna (emas lembut atau pirus lembut).
     *
     * @param originX Koordinat X sumber kemunculan partikel.
     * @param originY Koordinat Y sumber kemunculan partikel.
     * @returns Objek FireflyParticle baru.
     */
    function createFireflyParticle(originX: number, originY: number): FireflyParticle {
      const angle = Math.random() * Math.PI * 2;
      const spread = 8 + Math.random() * 28;
      return {
        x: originX + Math.cos(angle) * spread,
        y: originY + Math.sin(angle) * spread,
        vx: (Math.random() - 0.5) * 0.45,
        vy: -0.15 - Math.random() * 0.4,
        radius: 1.4 + Math.random() * 2.1,
        alpha: 0.05,
        targetAlpha: 0.28 + Math.random() * 0.38,
        phase: Math.random() * Math.PI * 2,
        phaseSpeed: 0.025 + Math.random() * 0.03,
        hueType: Math.random() > 0.28 ? 'gold' : 'turquoise',
      };
    }

    // Inisialisasi partikel awal secara terkendali
    for (let i = 0; i < MAX_PARTICLES; i++) {
      particles.push(createFireflyParticle(pointer.currentX, pointer.currentY));
    }

    /**
     * Menangani perubahan ukuran jendela browser agar dimensi canvas tetap akurat.
     */
    function handleWindowResize(): void {
      if (!canvas) return;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    }

    /**
     * Menangani pergerakan mouse pengguna tanpa memicu pembaruan DOM yang berat.
     *
     * @param event Objek MouseEvent dari browser.
     */
    function handlePointerMove(event: MouseEvent): void {
      pointer.targetX = event.clientX;
      pointer.targetY = event.clientY;
      pointer.isActive = true;
      pointer.lastMoveTime = performance.now();
    }

    let animationFrameId = 0;

    /**
     * Loop render utama menggunakan requestAnimationFrame untuk menggambar cahaya lembut (soft glow)
     * dan pergerakan organik partikel kunang-kunang.
     *
     * @param now Timestamp performa saat ini.
     */
    function renderFrame(now: number): void {
      if (!ctx) return;

      ctx.clearRect(0, 0, width, height);

      // Interpolasi halus posisi pointer
      pointer.currentX = interpolatePosition(pointer.currentX, pointer.targetX, 0.14);
      pointer.currentY = interpolatePosition(pointer.currentY, pointer.targetY, 0.14);

      const idleElapsed = now - pointer.lastMoveTime;
      const masterOpacity = pointer.isActive
        ? idleElapsed > 4000
          ? Math.max(0.2, 1 - (idleElapsed - 4000) / 3000)
          : 1
        : 0.35;

      // 1. Gambar cahaya lembut (soft radial glow) di sekitar pointer
      const glowRadius = 95;
      const radialGlow = ctx.createRadialGradient(
        pointer.currentX,
        pointer.currentY,
        2,
        pointer.currentX,
        pointer.currentY,
        glowRadius
      );
      radialGlow.addColorStop(0, `rgba(215, 181, 109, ${0.15 * masterOpacity})`);
      radialGlow.addColorStop(0.45, `rgba(69, 198, 198, ${0.06 * masterOpacity})`);
      radialGlow.addColorStop(1, 'rgba(8, 27, 58, 0)');

      ctx.fillStyle = radialGlow;
      ctx.beginPath();
      ctx.arc(pointer.currentX, pointer.currentY, glowRadius, 0, Math.PI * 2);
      ctx.fill();

      // 2. Perbarui dan gambar setiap partikel kunang-kunang dengan jumlah terbatas
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.phase += p.phaseSpeed;
        p.x += p.vx + Math.sin(p.phase) * 0.22;
        p.y += p.vy + Math.cos(p.phase * 0.8) * 0.15;

        const distToPointer = Math.hypot(p.x - pointer.currentX, p.y - pointer.currentY);

        // Jika partikel terlalu jauh dari pointer, daur ulang secara halus di dekat pointer
        if (distToPointer > 150) {
          const recycled = createFireflyParticle(pointer.currentX, pointer.currentY);
          particles[i] = recycled;
          continue;
        }

        const pulse = (Math.sin(p.phase) + 1) * 0.5;
        const effectiveAlpha = p.targetAlpha * (0.45 + pulse * 0.55) * masterOpacity;

        const particleGlow = ctx.createRadialGradient(
          p.x,
          p.y,
          0.2,
          p.x,
          p.y,
          p.radius * 3.8
        );

        if (p.hueType === 'gold') {
          particleGlow.addColorStop(0, `rgba(247, 239, 224, ${effectiveAlpha})`);
          particleGlow.addColorStop(0.4, `rgba(215, 181, 109, ${effectiveAlpha * 0.75})`);
          particleGlow.addColorStop(1, 'rgba(215, 181, 109, 0)');
        } else {
          particleGlow.addColorStop(0, `rgba(239, 250, 250, ${effectiveAlpha * 0.9})`);
          particleGlow.addColorStop(0.4, `rgba(69, 198, 198, ${effectiveAlpha * 0.65})`);
          particleGlow.addColorStop(1, 'rgba(69, 198, 198, 0)');
        }

        ctx.fillStyle = particleGlow;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius * 3.8, 0, Math.PI * 2);
        ctx.fill();
      }

      animationFrameId = window.requestAnimationFrame(renderFrame);
    }

    window.addEventListener('resize', handleWindowResize, { passive: true });
    window.addEventListener('mousemove', handlePointerMove, { passive: true });
    animationFrameId = window.requestAnimationFrame(renderFrame);

    return () => {
      window.cancelAnimationFrame(animationFrameId);
      window.removeEventListener('resize', handleWindowResize);
      window.removeEventListener('mousemove', handlePointerMove);
    };
  }

  let cleanupFirefly = initFireflyCursorSystem();

  window.addEventListener('pagehide', () => {
    cleanupFirefly();
  });
</script>
