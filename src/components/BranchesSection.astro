---
/**
 * Komponen BranchesSection (Bagian H pada Struktur Website).
 * Menampilkan daftar kantor pusat dan jaringan kantor cabang di berbagai wilayah Indonesia
 * berdasarkan Slide 42 & 43, beserta daftar kota keberangkatan (embarkasi) pada Slide 17 & 19–22.
 */
import { SITE_CONFIG } from '../data/site-config';
import {
  BRANCH_NETWORK,
  EMBARKATION_CITIES_IN_DOC,
  getBranchesGroupedByIsland,
} from '../data/branches';
import { getOfficialWhatsAppUrl } from '../utils/whatsapp';
import VerificationBadge from './VerificationBadge.astro';

const groupedBranches = getBranchesGroupedByIsland();
const islandKeys = Object.keys(groupedBranches) as Array<keyof typeof groupedBranches>;
---

<section
  id="cabang"
  class="section-padding bg-ivory text-charcoal"
  aria-labelledby="cabang-heading"
>
  <div class="container-luxury">
    <div class="max-w-3xl space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-eyebrow">Lokasi Kantor &amp; Jaringan Cabang</span>
        <VerificationBadge status="NEEDS_CONFIRMATION" />
      </div>
      <h2
        id="cabang-heading"
        class="font-editorial text-3xl font-bold text-navy-800 sm:text-4xl lg:text-5xl"
      >
        Kantor Pusat &amp; Jaringan Kantor Cabang di Indonesia
      </h2>
      <p class="text-base sm:text-lg text-charcoal-muted leading-relaxed">
        Dokumen Product Knowledge PT Samira Ali Wisata mencantumkan kantor pusat di Jakarta Timur serta daftar kantor cabang di berbagai wilayah. Status operasional dan alamat detail masing-masing cabang dapat dikonfirmasi melalui layanan pusat.
      </p>
    </div>

    <!-- Kartu Kantor Pusat & Kota Embarkasi -->
    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-12">
      <!-- Kantor Pusat -->
      <div class="lg:col-span-6 rounded-2xl bg-royal-gradient p-6 sm:p-8 text-white shadow-luxury flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="rounded-full bg-gold-400/20 border border-gold-300/40 px-3 py-1 text-xs font-semibold text-gold-300">
              Kantor Pusat (Head Office)
            </span>
            <VerificationBadge status={SITE_CONFIG.headOffice.status} variant="dark" />
          </div>
          <h3 class="font-editorial text-2xl sm:text-3xl font-bold text-white">
            {SITE_CONFIG.legalEntityName}
          </h3>
          <p class="text-sm sm:text-base leading-relaxed text-ivory-100">
            {SITE_CONFIG.headOffice.addressPrimary}
          </p>
          <p class="rounded-xl bg-white/10 p-3 text-xs text-ivory-200/85 border border-white/10">
            <strong>Catatan Verifikasi Alamat:</strong> Slide 43 mencantumkan <em>Jl. Malaka Merah No. 8 (13460)</em>, sedangkan footer Slide 4 &amp; 7 mencantumkan <em>Jl. Malaka Merah Raya No. 7/6</em>. Konfirmasikan titik kunjungan sebelum datang langsung.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-white/15 flex flex-wrap items-center justify-between gap-3">
          <span class="text-xs text-ivory-200/80">
            WhatsApp Pusat: <strong>{SITE_CONFIG.whatsapp.displayNumber}</strong>
          </span>
          <a
            href={getOfficialWhatsAppUrl({
              customQuestion: 'Saya ingin mengonfirmasi alamat dan jam layanan Kantor Pusat Samira Travel di Jakarta Timur',
            })}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary-gold !px-4 !py-2 !text-xs"
          >
            <span>Hubungi Kantor Pusat</span>
          </a>
        </div>
      </div>

      <!-- Kota Keberangkatan (Embarkasi) -->
      <div class="lg:col-span-6 card-surface p-6 sm:p-8 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-royal-700">
              Akses Keberangkatan Daerah (Slide 17 &amp; 19–22)
            </span>
            <VerificationBadge status="NEEDS_CONFIRMATION" />
          </div>
          <h3 class="font-editorial text-2xl sm:text-3xl font-bold text-navy-800">
            Kota-Kota Besar Keberangkatan (Embarkasi)
          </h3>
          <p class="text-xs sm:text-sm text-charcoal-muted leading-relaxed">
            Materi produk menyebutkan opsi keberangkatan dari berbagai bandara kota besar di Indonesia sesuai jadwal musim yang dibuka:
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            {
              EMBARKATION_CITIES_IN_DOC.map((city) => (
                <button
                  type="button"
                  data-open-consultation-modal
                  data-context-city={city}
                  class="inline-flex items-center gap-1.5 rounded-xl border border-navy-200 bg-ivory-50 px-3.5 py-2 text-xs font-semibold text-navy-800 transition-colors hover:border-gold-400 hover:bg-gold-50"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-royal-600" aria-hidden="true" />
                  <span>{city}</span>
                </button>
              ))
            }
          </div>
        </div>
        <p class="mt-6 pt-3 border-t border-navy-100 text-xs text-charcoal-muted">
          Klik salah satu kota di atas untuk menanyakan ketersediaan jadwal keberangkatan terbaru dari kota tersebut.
        </p>
      </div>
    </div>

    <!-- Daftar Cabang Berdasarkan Kepulauan -->
    <div class="mt-12 space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-navy-200/70 pb-4">
        <div>
          <h3 class="font-editorial text-2xl font-bold text-navy-800">
            Daftar {BRANCH_NETWORK.length} Wilayah Kantor Cabang pada Materi Klien
          </h3>
          <p class="text-xs text-charcoal-muted mt-0.5">
            Catatan: Slide 42 mencantumkan 24 nomor urut cabang di mana Cabang Jambi tertulis pada nomor 7 dan 24 (23 wilayah unik).
          </p>
        </div>
        <VerificationBadge status="PLACEHOLDER" customLabel="Alamat Detail Cabang Menunggu Data" />
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          islandKeys.map((island) => (
            <div class="card-surface p-6 space-y-4">
              <div class="flex items-center justify-between border-b border-navy-100 pb-3">
                <h4 class="font-editorial text-xl font-bold text-navy-800">
                  Wilayah {island}
                </h4>
                <span class="rounded-full bg-navy-50 px-2.5 py-0.5 text-xs font-semibold text-royal-700">
                  {groupedBranches[island].length} Cabang
                </span>
              </div>
              <ul class="space-y-2.5 text-xs">
                {groupedBranches[island].map((branch) => (
                  <li class="flex items-center justify-between gap-2 rounded-xl bg-ivory-50 px-3.5 py-2.5 border border-navy-100/60">
                    <div>
                      <strong class="font-semibold text-navy-800 block">{branch.name}</strong>
                      <span class="text-[11px] text-charcoal-muted">{branch.cityOrRegion}</span>
                    </div>
                    <button
                      type="button"
                      data-open-consultation-modal
                      data-context-city={branch.cityOrRegion}
                      class="shrink-0 rounded-lg border border-navy-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-royal-700 hover:bg-navy-50"
                    >
                      Tanya Info
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
