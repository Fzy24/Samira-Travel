---
/**
 * Komponen WhyChooseSection (Bagian F & G pada Struktur Website).
 * Menampilkan alasan objektif memilih Samira Travel (berdasarkan informasi yang dapat dijelaskan)
 * serta bagian Legalitas, Penghargaan, dan Rekam Jejak dengan penanda verifikasi yang transparan.
 */
import { ADVANTAGE_PILLARS } from '../data/facilities';
import { COMPANY_LICENSES, COMPANY_AWARDS } from '../data/company';
import VerificationBadge from './VerificationBadge.astro';
---

<section
  id="keunggulan"
  class="section-padding bg-navy-800 bg-subtle-arabesque text-white"
  aria-labelledby="keunggulan-heading"
>
  <div class="container-luxury">
    <!-- Bagian F: Alasan Memilih Samira Travel -->
    <div class="max-w-3xl space-y-3">
      <span class="badge-eyebrow-dark">Keunggulan &amp; Pendekatan Layanan</span>
      <h2
        id="keunggulan-heading"
        class="font-editorial text-3xl font-bold text-white sm:text-4xl lg:text-5xl"
      >
        Alasan Merencanakan Perjalanan Ibadah Bersama Samira Travel
      </h2>
      <p class="text-base sm:text-lg text-ivory-200/85 leading-relaxed">
        Disusun berdasarkan struktur layanan, pendampingan operasional, dan tata kelola perjalanan yang tercantum dalam dokumentasi produk perusahaan.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        ADVANTAGE_PILLARS.map((pillar) => (
          <div class="rounded-2xl border border-white/15 bg-navy-900/75 p-6 backdrop-blur-sm transition-all duration-300 hover:border-gold-400/50">
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gold-400/15 border border-gold-400/35 text-gold-300 font-editorial text-xl font-bold">
                &#10022;
              </span>
              <VerificationBadge status={pillar.status} variant="dark" />
            </div>
            <h3 class="mt-4 font-editorial text-2xl font-bold text-white">
              {pillar.title}
            </h3>
            <p class="mt-1 text-xs font-medium text-turquoise-300">
              {pillar.subtitle}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-ivory-200/85">
              {pillar.description}
            </p>
            <p class="mt-4 pt-3 border-t border-white/10 text-[11px] text-ivory-200/60">
              Rujukan materi: {pillar.sourceSlide}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Bagian G: Legalitas dan Rekam Jejak -->
    <div id="rekam-jejak" class="mt-20 pt-16 border-t border-white/15">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-3xl space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="badge-eyebrow-dark">Legalitas &amp; Rekam Jejak</span>
            <VerificationBadge status="NEEDS_CONFIRMATION" variant="dark" />
          </div>
          <h2 class="font-editorial text-3xl font-bold text-white sm:text-4xl">
            Informasi Perizinan &amp; Dokumentasi Penghargaan pada Materi Klien
          </h2>
          <p class="text-sm sm:text-base text-ivory-200/85 leading-relaxed">
            Seluruh nomor izin dan catatan penghargaan di bawah ini bersumber dari dokumen Product Knowledge klien. Sesuai tata kelola publikasi, klaim dan status masa berlaku wajib dikonfirmasi oleh klien sebelum rilis publik final.
          </p>
        </div>
      </div>

      <!-- Grid Kartu Nomor Izin -->
      <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          COMPANY_LICENSES.map((lic) => (
            <div class="rounded-2xl border border-gold-400/35 bg-navy-900/90 p-6 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="rounded-lg bg-gold-400/15 px-3 py-1 text-xs font-bold text-gold-300">
                    {lic.type}
                  </span>
                  <VerificationBadge status={lic.status} variant="dark" />
                </div>
                <h3 class="font-editorial text-xl font-bold text-white">
                  {lic.label}
                </h3>
                <p class="font-mono text-lg font-bold text-turquoise-300 tracking-wide">
                  {lic.number}
                </p>
                <p class="text-xs text-ivory-200/80">
                  {lic.issuingBody} &bull; {lic.yearMentioned}
                </p>
              </div>
              <p class="mt-4 pt-3 border-t border-white/10 text-[11px] leading-relaxed text-ivory-200/65">
                {lic.verificationDisclaimer}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Daftar Kandidat Dokumentasi Penghargaan & Rekor -->
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          COMPANY_AWARDS.map((award) => (
            <div class="rounded-2xl border border-white/15 bg-navy-900/65 p-6 flex flex-col justify-between gap-4">
              <div class="space-y-2.5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="text-xs font-semibold uppercase tracking-wider text-gold-300">
                    {award.organization}
                  </span>
                  <VerificationBadge status={award.status} variant="dark" />
                </div>
                <h3 class="font-editorial text-2xl font-bold text-white">
                  {award.title}
                </h3>
                <p class="text-xs sm:text-sm leading-relaxed text-ivory-200/85">
                  {award.contextDescription}
                </p>
              </div>
              <div class="flex items-center justify-between border-t border-white/10 pt-3 text-[11px] text-ivory-200/65">
                <span>Konteks Waktu: {award.yearOrDateInDoc}</span>
                <span>{award.sourceSlide}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
