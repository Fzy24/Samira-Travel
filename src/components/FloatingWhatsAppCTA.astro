---
/**
 * Komponen FloatingWhatsAppCTA.
 * Menyediakan tombol melayang aksesibel di sudut kanan bawah layar untuk memudahkan
 * calon jamaah memulai konsultasi WhatsApp kapan saja saat membaca halaman.
 */
import { SITE_CONFIG } from '../data/site-config';
import { getOfficialWhatsAppUrl } from '../utils/whatsapp';

const floatingWaUrl = getOfficialWhatsAppUrl();
---

<div class="fixed bottom-5 right-5 z-40 flex items-center gap-2">
  <a
    href={floatingWaUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Konsultasi via WhatsApp ${SITE_CONFIG.brandName} di nomor ${SITE_CONFIG.whatsapp.displayNumber}`}
    class="group flex items-center gap-3 rounded-full border border-gold-300/60 bg-navy-800/95 px-4 py-3 text-white shadow-luxury-hover backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:border-gold-300 hover:bg-navy-700"
  >
    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gold-400 text-navy-900 shadow-sm transition-transform duration-200 group-hover:scale-105">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.124 1.529 5.856l-1.529 5.584 5.715-1.499c1.694.925 3.635 1.459 5.702 1.459 6.627 0 12-5.373 12-12s-5.39-11.4-11.417-11.4z"/>
      </svg>
    </span>
    <span class="hidden sm:block pr-1 text-left">
      <span class="block text-[10px] font-semibold uppercase tracking-wider text-gold-300">
        Konsultasi Jamaah
      </span>
      <span class="block text-xs font-bold text-white">
        {SITE_CONFIG.whatsapp.displayNumber}
      </span>
    </span>
  </a>
</div>
