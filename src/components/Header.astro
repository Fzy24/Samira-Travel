---
/**
 * Komponen Header.
 * Menampilkan identitas logo Samira Travel, navigasi anchor utama untuk homepage maupun halaman dalam,
 * indikator Mode Demo, tombol CTA WhatsApp terpusat, serta menu drawer responsif untuk perangkat mobile.
 */
import { SITE_CONFIG, isDemoModeEnabled } from '../data/site-config';
import { getOfficialWhatsAppUrl } from '../utils/whatsapp';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isHome = currentPath === '/' || currentPath === '';

/**
 * Menghasilkan daftar tautan navigasi yang otomatis menyesuaikan apakah pengguna
 * berada di halaman beranda (anchor langsung) atau halaman pendukung.
 *
 * @param onHomePage Boolean apakah halaman aktif adalah homepage ('/').
 * @returns Array item navigasi dengan label dan href yang sesuai.
 */
function getNavigationItems(onHomePage: boolean) {
  const prefix = onHomePage ? '' : '/';
  return [
    { label: 'Profil', href: `${prefix}#profil` },
    { label: 'Layanan', href: `${prefix}#layanan` },
    { label: 'Paket & Fasilitas', href: `${prefix}#paket` },
    { label: 'Keunggulan', href: `${prefix}#keunggulan` },
    { label: 'Rekam Jejak', href: `${prefix}#rekam-jejak` },
    { label: 'Hotel', href: `${prefix}#hotel-fasilitas` },
    { label: 'Cabang', href: `${prefix}#cabang` },
    { label: 'Galeri', href: `${prefix}#galeri` },
    { label: 'FAQ', href: `${prefix}#faq` },
    { label: 'Kontak', href: `${prefix}#kontak` },
  ];
}

const navItems = getNavigationItems(isHome);
const whatsappHeaderUrl = getOfficialWhatsAppUrl();
const demoActive = isDemoModeEnabled();
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-white/10 bg-navy-700/95 text-white backdrop-blur-md transition-all duration-300"
>
  {
    demoActive && (
      <div class="border-b border-gold-400/25 bg-navy-800 px-4 py-1.5 text-center text-xs text-ivory-200">
        <div class="container-luxury flex flex-wrap items-center justify-between gap-2">
          <p class="mx-auto sm:mx-0 flex items-center gap-2">
            <span class="inline-block h-2 w-2 rounded-full bg-gold-400" aria-hidden="true" />
            <span>
              <strong class="font-semibold text-gold-300">Mode Presentasi Demo Aktif:</strong> Nomor izin, jadwal terbaru, dan detail paket menunggu konfirmasi final klien sebelum publikasi resmi.
            </span>
          </p>
          <a
            href={ isHome ? '#kontak' : '/#kontak' }
            class="hidden sm:inline-flex items-center gap-1 font-medium text-turquoise-300 underline-offset-4 hover:underline"
          >
            Lihat Status Data &rarr;
          </a>
        </div>
      </div>
    )
  }

  <div class="container-luxury flex h-20 items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a
      href="/"
      class="group flex items-center gap-3 rounded-lg focus:outline-none"
      aria-label={`${SITE_CONFIG.brandName} - ${SITE_CONFIG.legalEntityName} Beranda`}
    >
      <div class="relative flex h-12 w-auto items-center overflow-hidden rounded-lg border border-gold-400/40 bg-navy-800 px-2 py-1 shadow-sm transition-transform duration-200 group-hover:border-gold-300">
        <img
          src="/images/logo/samira-logo-badge.webp"
          alt={`Logo ${SITE_CONFIG.brandName}`}
          width="118"
          height="43"
          class="h-9 w-auto object-contain"
        />
      </div>
      <div class="hidden sm:block">
        <span class="block font-editorial text-xl font-bold tracking-wide text-white">
          SAMIRA <span class="text-gold-400">TRAVEL</span>
        </span>
        <span class="block text-[11px] font-medium tracking-wider text-ivory-200/80 uppercase">
          {SITE_CONFIG.legalEntityName}
        </span>
      </div>
    </a>

    <!-- Navigasi Desktop -->
    <nav aria-label="Navigasi Utama" class="hidden xl:flex items-center gap-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-ivory-100/90 transition-colors duration-200 hover:bg-white/10 hover:text-gold-300"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Aksi Kanan: CTA WhatsApp & Tombol Menu Mobile -->
    <div class="flex items-center gap-2.5">
      <button
        type="button"
        data-open-consultation-modal
        class="hidden md:inline-flex items-center gap-2 rounded-xl border border-gold-400/40 bg-white/5 px-3.5 py-2.5 text-xs font-semibold text-gold-300 transition-colors hover:bg-white/15"
      >
        <span>Pilih Konteks Pesan</span>
      </button>

      <a
        href={whatsappHeaderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary-gold !px-4 !py-2.5 !text-xs sm:!text-sm"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.124 1.529 5.856l-1.529 5.584 5.715-1.499c1.694.925 3.635 1.459 5.702 1.459 6.627 0 12-5.373 12-12s-5.39-11.4-11.417-11.4z"/>
        </svg>
        <span>Konsultasi WhatsApp</span>
      </a>

      <!-- Tombol Hamburger Mobile -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex xl:hidden items-center justify-center rounded-xl border border-white/20 bg-white/5 p-2.5 text-ivory-100 transition-colors hover:bg-white/15"
        aria-expanded="false"
        aria-controls="mobile-navigation-drawer"
        aria-label="Buka menu navigasi"
      >
        <svg id="icon-menu-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-menu-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Drawer Navigasi Mobile -->
  <div
    id="mobile-navigation-drawer"
    class="hidden xl:hidden border-t border-white/10 bg-navy-800/98 px-4 pt-3 pb-6 shadow-2xl"
    aria-label="Menu Navigasi Mobile"
  >
    <div class="container-luxury flex flex-col gap-1.5">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-mobile-nav-link
            class="rounded-xl px-4 py-2.5 text-sm font-medium text-ivory-100 transition-colors hover:bg-white/10 hover:text-gold-300"
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-3 flex flex-col sm:flex-row gap-2.5 border-t border-white/10 pt-4">
        <button
          type="button"
          data-open-consultation-modal
          class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-gold-400/40 bg-white/10 px-4 py-3 text-sm font-semibold text-gold-300"
        >
          <span>Kustomisasi Pesan Konsultasi</span>
        </button>
        <a
          href={whatsappHeaderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary-gold w-full"
        >
          <span>Chat WhatsApp ({SITE_CONFIG.whatsapp.displayNumber})</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  /**
   * Mengatur interaksi buka/tutup menu navigasi mobile serta penutupan otomatis
   * saat tautan anchor diklik atau tombol Escape ditekan oleh pengguna.
   */
  function setupMobileNavigation(): void {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-navigation-drawer');
    const openIcon = document.getElementById('icon-menu-open');
    const closeIcon = document.getElementById('icon-menu-close');
    const navLinks = document.querySelectorAll('[data-mobile-nav-link]');

    if (!toggleBtn || !drawer || !openIcon || !closeIcon) {
      return;
    }

    /**
     * Mengubah status keterbukaan drawer menu mobile dan atribut aksesibilitas aria-expanded.
     *
     * @param isOpen Nilai boolean apakah menu harus dibuka atau ditutup.
     */
    function setDrawerState(isOpen: boolean): void {
      if (!toggleBtn || !drawer || !openIcon || !closeIcon) return;
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      toggleBtn.setAttribute('aria-label', isOpen ? 'Tutup menu navigasi' : 'Buka menu navigasi');
      drawer.classList.toggle('hidden', !isOpen);
      openIcon.classList.toggle('hidden', isOpen);
      closeIcon.classList.toggle('hidden', !isOpen);
    }

    toggleBtn.addEventListener('click', () => {
      const currentlyExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      setDrawerState(!currentlyExpanded);
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setDrawerState(false);
      });
    });

    window.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        setDrawerState(false);
        toggleBtn.focus();
      }
    });
  }

  setupMobileNavigation();
</script>
