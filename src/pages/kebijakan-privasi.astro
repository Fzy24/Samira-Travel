---
/**
 * Halaman Kebijakan Privasi (Privacy Policy) Samira Travel.
 * Menjelaskan tata kelola komunikasi pengunjung dan ketiadaan pengumpulan data pribadi sensitif di website versi pertama.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../data/site-config';
---

<BaseLayout
  title={`Kebijakan Privasi | ${SITE_CONFIG.brandName}`}
  description={`Kebijakan privasi dan pelindungan informasi pengunjung pada website profil ${SITE_CONFIG.brandName} (${SITE_CONFIG.legalEntityName}).`}
  currentPath="/kebijakan-privasi"
>
  <section class="section-padding bg-ivory text-charcoal">
    <div class="container-luxury max-w-4xl">
      <div class="card-surface p-8 sm:p-12 space-y-6">
        <span class="badge-eyebrow">Tata Kelola Privasi</span>
        <h1 class="font-editorial text-3xl sm:text-4xl font-bold text-navy-800">
          Kebijakan Privasi Pengunjung
        </h1>
        <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed">
          Website company profile <strong>{SITE_CONFIG.brandName} ({SITE_CONFIG.legalEntityName})</strong> versi pertama ini dirancang sebagai media informasi profil perusahaan, layanan, dan memfasilitasi konsultasi awal calon jamaah.
        </p>

        <div class="space-y-4 text-sm leading-relaxed text-charcoal-muted">
          <h2 class="font-editorial text-2xl font-bold text-navy-800">
            1. Tidak Ada Penyimpanan Data Pribadi Sensitif di Website
          </h2>
          <p>
            Website ini bersifat statis dan tidak menyediakan sistem pendaftaran akun, database pelanggan, maupun penyimpanan dokumen identitas (seperti nomor paspor, NIK KTP, atau informasi rekening keuangan) di dalam server website.
          </p>

          <h2 class="font-editorial text-2xl font-bold text-navy-800">
            2. Konsultasi Melalui Tautan WhatsApp
          </h2>
          <p>
            Ketika Anda menekan tombol <em>Konsultasi via WhatsApp</em> atau menyusun konteks pesan melalui jendela bantuan konsultasi, aplikasi ini hanya membentuk URL <code>https://wa.me/</code> di perangkat Anda untuk dialihkan ke aplikasi WhatsApp resmi menuju nomor <strong>{SITE_CONFIG.whatsapp.displayNumber}</strong>.
          </p>

          <h2 class="font-editorial text-2xl font-bold text-navy-800">
            3. Keamanan Verifikasi Pendaftaran
          </h2>
          <p>
            Penyerahan dokumen persyaratan ibadah umrah, haji khusus, atau halal tour hanya dilakukan setelah calon jamaah berkomunikasi secara resmi dan terverifikasi dengan tim administrasi {SITE_CONFIG.legalEntityName}.
          </p>
        </div>

        <div class="pt-4 border-t border-navy-100">
          <a href="/" class="btn-primary-navy">
            <span>&larr; Kembali ke Beranda</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
